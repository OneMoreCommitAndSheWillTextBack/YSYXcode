-+	ptr = start;
-+	vector = (unsigned char*)vectors_page;
-+
-+	/* only set IRQ and FIQ */
-+#if defined(CONFIG_CPU_USE_DOMAINS)
-+	/* IRQ */
-+	memcpy((void *)0xffff0018, (void*)(ptr + 0x18), 4);
