-    int offset;
-
-    for (offset = fdt_next_node(fdt, -1, NULL);;
-         offset = fdt_next_node(fdt, offset, NULL)) {
-        uint32_t phandle;
-
-        if (offset == -FDT_ERR_NOTFOUND)
-            return max_phandle;
-
-        if (offset < 0)
-            return (uint32_t)-1;
-
-        phandle = fdt_get_phandle(fdt, offset);
-        if (phandle == (uint32_t)-1)
-            continue;
-
-        if (phandle > max_phandle)
-            max_phandle = phandle;
