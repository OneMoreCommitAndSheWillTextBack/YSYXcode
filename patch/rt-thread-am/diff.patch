-    if (msg->fault_type == MM_FAULT_TYPE_PAGE_FAULT)
-    {
-        RT_ASSERT(pa == ARCH_MAP_FAILED);
-        RT_ASSERT(!(varea->flag & MMF_PREFETCH));
-        err = _fetch_page(varea, msg);
