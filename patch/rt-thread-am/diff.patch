-                msg = "undefined symbol {}:".format(sym.name)
-                for node in self.node_iter():
-                    if sym in node.referenced:
-                        msg += "\n\n- Referenced at {}:{}:\n\n{}" \
-                               .format(node.filename, node.linenr, node)
-                self._warn(msg)
