-    }
-
-    resp->Status = RNDIS_STATUS_SUCCESS;
-
-    response->buffer = resp;
-
-    {
-        rt_base_t level = rt_hw_interrupt_disable();
-        rt_list_insert_before(&((rt_rndis_eth_t)func->user_data)->response_list, &response->list);
-        rt_hw_interrupt_enable(level);
-    }
-
-    return RT_EOK;
