-
-    RT_ASSERT(device != RT_NULL);
-    RT_ASSERT(name != RT_NULL);
-    RT_ASSERT(device->ops != RT_NULL);
-    RT_ASSERT(device->ops->create != RT_NULL);
-    RT_ASSERT(device->ops->destroy != RT_NULL);
-    RT_ASSERT(device->ops->copy != RT_NULL);
