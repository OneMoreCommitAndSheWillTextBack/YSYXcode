-
-def _choice_syms_info(choice):
-    # Returns a string listing the choice symbols in 'choice'. Adds
-    # "(selected)" next to the selected one.
-
-    s = "Choice symbols:\n"
-
-    for sym in choice.syms:
-        s += "  - " + sym.name
-        if sym is choice.selection:
-            s += " (selected)"
-        s += "\n"
-
-    return s + "\n"
