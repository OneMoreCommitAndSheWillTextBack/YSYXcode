-
-	putc_init(&pb, fp);
-
-	va_start(arp, fmt);
-
-	for (;;) {
-		tc = *fmt++;
-		if (tc == 0) break;			/* End of format string */
-		if (tc != '%') {			/* Not an escape character (pass-through) */
-			putc_bfd(&pb, tc);
-			continue;
-		}
