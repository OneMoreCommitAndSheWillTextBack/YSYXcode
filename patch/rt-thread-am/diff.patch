-
-#include <rtdef.h>
-
-struct virtio_mmio_config
-{
-    rt_uint32_t magic;                  /* [0x00]<RO> Magic value */
-    rt_uint32_t version;                /* [0x04]<RO> Device version number */
-    rt_uint32_t device_id;              /* [0x08]<RO> Virtio Subsystem Device ID */
