-        }
-    }
-    else
-    {
-        LOG_W("%s: failed on va %p inside varea %p(%s)", __func__, msg->fault_vaddr, varea,
-            varea->mem_obj->get_name ? varea->mem_obj->get_name(varea) : "unknow");
-    }
