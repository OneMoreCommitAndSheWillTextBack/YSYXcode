-        ++pathname;
-    }
-
-    /* root not have sibling, so skip */
-    if (dtb_node->parent == NULL || !strcmp(dtb_node->path, "/"))
-    {
-        dtb_node = dtb_node->child;
-    }
-
-    pathname_sz = strlen(pathname) + 1;
