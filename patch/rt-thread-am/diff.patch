-static struct cromfs_avl_struct* cromfs_avl_find(avl_key_t key, struct cromfs_avl_struct* ptree)
-{
-    for (;;)
-    {
-        if (ptree == AVL_EMPTY)
-        {
-            return (struct cromfs_avl_struct *)0;
-        }
-        if (key == ptree->avl_key)
-        {
-            break;
-        }
-        if (key < ptree->avl_key)
-        {
-            ptree = ptree->avl_left;
-        }
-        else
-        {
-            ptree = ptree->avl_right;
