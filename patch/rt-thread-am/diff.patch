-    }
-    offset = (size_t)map_va & ARCH_PAGE_MASK;
-    map_size += (offset + ARCH_PAGE_SIZE - 1);
-    map_size &= ~ARCH_PAGE_MASK;
-    map_va = (void *)((size_t)map_va & ~ARCH_PAGE_MASK);
-
-    varea = _lwp_map_user_varea(lwp, map_va, map_size, flags);
-
-    return varea;
-}
