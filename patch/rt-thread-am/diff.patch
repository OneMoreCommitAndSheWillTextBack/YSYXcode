-        }
-
-        if (queue->evt_notify != RT_NULL)
-            queue->evt_notify(queue, RT_DATAQUEUE_EVENT_LWM);
-
-        return result;
-    }
-
-__exit:
-    rt_hw_interrupt_enable(level);
-    if ((result == RT_EOK) && (queue->evt_notify != RT_NULL))
-    {
-        queue->evt_notify(queue, RT_DATAQUEUE_EVENT_POP);
-    }
-
-    return result;
-}
