-{
-    uint8_t *bp = (uint8_t *)property;
-
-    bp[0] = value >> 56;
-    bp[1] = (value >> 48) & 0xff;
-    bp[2] = (value >> 40) & 0xff;
-    bp[3] = (value >> 32) & 0xff;
-    bp[4] = (value >> 24) & 0xff;
-    bp[5] = (value >> 16) & 0xff;
-    bp[6] = (value >> 8) & 0xff;
-    bp[7] = value & 0xff;
