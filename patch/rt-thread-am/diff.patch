-int rt_aspace_control(rt_aspace_t aspace, void *addr, enum rt_mmu_cntl cmd)
-{
-    int err;
-    rt_varea_t varea;
-
-    WR_LOCK(aspace);
-    varea = _aspace_bst_search(aspace, addr);
-    WR_UNLOCK(aspace);
-
-    if (varea)
-    {
-        err = rt_hw_mmu_control(aspace, varea->start, varea->size, cmd);
