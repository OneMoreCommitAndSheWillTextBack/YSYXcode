-int dfs_ramfs_write(struct dfs_file *fd, const void *buf, size_t count)
-{
-    struct ramfs_dirent *dirent;
-    struct dfs_ramfs *ramfs;
-
-    dirent = (struct ramfs_dirent *)fd->vnode->data;
