-    mmcsd_dbg("SDIO: disabling function %d\n", func->num);
-
-    reg =  sdio_io_readb(func0, SDIO_REG_CCCR_IO_EN, &ret);
-    if (ret)
-        goto err;
-
-    reg &= ~(1 << func->num);
-
-    ret = sdio_io_writeb(func0, SDIO_REG_CCCR_IO_EN, reg);
-    if (ret)
-        goto err;
-
-    mmcsd_dbg("SDIO: disabled function successfull\n");
-
-    return 0;
-
-err:
