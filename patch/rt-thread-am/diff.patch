-DWORD get_fattime(void)
-{
-    DWORD fat_time = 0;
-    time_t now;
-    struct tm tm_now;
-
-    now = time(RT_NULL);
-    gmtime_r(&now, &tm_now);
-
-    fat_time = (DWORD)(tm_now.tm_year - 80) << 25 |
-               (DWORD)(tm_now.tm_mon + 1)   << 21 |
-               (DWORD)tm_now.tm_mday        << 16 |
-               (DWORD)tm_now.tm_hour        << 11 |
-               (DWORD)tm_now.tm_min         <<  5 |
-               (DWORD)tm_now.tm_sec / 2 ;
-
-    return fat_time;
-}
