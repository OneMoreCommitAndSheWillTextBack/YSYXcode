-    struct dfs_fdtable *fd_table;
-
-    fd_table = dfs_fdtable_get();
-    if (!fd_table) return -1;
-
-    dfs_lock();
-
-    rt_kprintf("fd type    ref magic  path\n");
-    rt_kprintf("-- ------  --- ----- ------\n");
-    for (index = 0; index < (int)fd_table->maxfd; index++)
-    {
-        struct dfs_file *fd = fd_table->fds[index];
-
-        if (fd && fd->vnode->fops)
