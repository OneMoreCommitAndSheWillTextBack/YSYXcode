-+{
-+	asm volatile(
-+		"	cpsie i			@ arch_local_irq_enable"
-+		:
-+		:
-+		: "memory", "cc");
-+}
-+
-+static inline void vmm_irq_disable(void)
-+{
-+	asm volatile(
-+		"	cpsid i			@ arch_local_irq_disable"
-+		:
-+		:
-+		: "memory", "cc");
-+}
-+
-+#endif
