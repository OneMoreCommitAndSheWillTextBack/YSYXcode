-        LOG_W("%s(%p,%lx): not in range of varea(%p,%lx)", __func__,
-            vaddr, ARCH_PAGE_SIZE, varea->start, varea->size);
-        err = -RT_EINVAL;
-    }
-    else
-    {
-        err = _do_named_map(
-            varea->aspace,
-            vaddr,
-            ARCH_PAGE_SIZE,
-            MM_PA_TO_OFF(page_pa),
-            varea->attr
-        );
-    }
-
-    return err;
-}
-
-#define ALIGNED(addr) (!((rt_size_t)(addr) & ARCH_PAGE_MASK))
