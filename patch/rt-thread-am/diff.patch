-        rt_schedule();
-    }
-    else
-    {
-        /* enable interrupt */
-        rt_hw_local_irq_enable(level);
-    }
-}
-RTM_EXPORT(rt_exit_critical);
-
-/**
- * @brief Get the scheduler lock level.
- *
