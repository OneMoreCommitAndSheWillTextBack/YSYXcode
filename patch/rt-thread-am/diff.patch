-int dfs_register(const struct dfs_filesystem_ops *ops)
-{
-    int ret = RT_EOK;
-    const struct dfs_filesystem_ops **empty = NULL;
-    const struct dfs_filesystem_ops **iter;
-
-    /* lock filesystem */
-    dfs_lock();
