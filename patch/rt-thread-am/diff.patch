-            goto err1;
-        }
-    }
-
-    /* call mount of this filesystem */
-    if ((*ops)->mount(fs, rwflag, data) < 0)
-    {
-        /* close device */
-        if (dev_id != NULL)
-            rt_device_close(fs->dev_id);
-
-        /* mount failed */
-        dfs_lock();
-        /* clear filesystem table entry */
-        rt_memset(fs, 0, sizeof(struct dfs_filesystem));
-
-        goto err1;
-    }
-
-    return 0;
-
-err1:
-    dfs_unlock();
-    rt_free(fullpath);
-
-    return -1;
-}
