-                        rt_kprintf("0x%x ", fdt32_to_cpu(cell[i]));
-                    }
-                    rt_kputs("\b>");
-                }
-                else
-                {
-                    /* print bytes array */
-                    int i;
-                    uint8_t *byte = (uint8_t *)value;
-
-                    rt_kputs("[");
-                    for (i = 0; i < size; ++i)
-                    {
-                       rt_kprintf("%02x ", *byte++);
-                    }
-                    rt_kputs("\b]");
-                }
