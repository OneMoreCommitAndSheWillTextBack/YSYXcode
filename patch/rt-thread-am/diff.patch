-    }
-
-    rt_mutex_take(&virtio_input_dev->rw_mutex, RT_WAITING_FOREVER);
-
-    rt_memcpy(buffer, &virtio_input_dev->bcst_events[pos], size);
-
-    rt_mutex_release(&virtio_input_dev->rw_mutex);
-
-    return size;
-}
-
