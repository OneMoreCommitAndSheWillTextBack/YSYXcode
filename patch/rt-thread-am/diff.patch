- *
- * @return RT_EOK on successful.
- */
-static rt_err_t _uac_descriptor_config(struct uac_ac_descriptor *ac,
-                                       rt_uint8_t cintf_nr, struct uac_as_descriptor *as, rt_uint8_t sintf_nr)
