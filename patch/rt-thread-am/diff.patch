-int clock_getres(clockid_t clockid, struct timespec *res)
-{
-#ifndef RT_USING_RTC
-    LOG_W(_WARNING_NO_RTC);
-    return -1;
-#else
-    int ret = 0;
-
-    if (res == RT_NULL)
