-    case RT_TIMER_CTRL_GET_PARM:
-        *(void **)arg = timer->parameter;
-        break;
-
-    case RT_TIMER_CTRL_SET_PARM:
-        timer->parameter = arg;
-        break;
-
-    default:
-        break;
-    }
-    rt_hw_interrupt_enable(level);
-
-    return RT_EOK;
