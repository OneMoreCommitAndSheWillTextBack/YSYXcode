-#if FF_USE_LFN		/* LFN configuration */
-#if FF_FS_EXFAT
-	if (fs->fs_type == FS_EXFAT) {	/* exFAT volume */
-		UINT nc = 0;
-
-		si = SZDIRE * 2; di = 0;	/* 1st C1 entry in the entry block */
-		hs = 0;
