-static rt_bool_t enc28j60_check_link_status(struct rt_spi_device *spi_device)
-{
-    uint16_t reg;
-
-    reg = enc28j60_phy_read(spi_device, PHSTAT2);
-
-    if (reg & PHSTAT2_LSTAT)
-    {
-        /* on */
-        return RT_TRUE;
-    }
-    else
-    {
-        /* off */
-        return RT_FALSE;
-    }
-}
