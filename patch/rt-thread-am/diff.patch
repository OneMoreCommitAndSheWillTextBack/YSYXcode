-        offset += req_size;
-        wr_ptr = (void *)((rt_uint8_t *)wr_ptr + (req_size << 9));
-        remain_size -= req_size;
-    }
-    rt_sem_release(part->lock);
-
-    /* the length of reading must align to SECTOR SIZE */
