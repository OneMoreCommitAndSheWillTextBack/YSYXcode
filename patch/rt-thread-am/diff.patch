-    queue->get_index += 1;
-    if (queue->get_index == queue->size)
-    {
-        queue->get_index = 0;
-    }
-    queue->is_full = 0;
-    if (queue->put_index == queue->get_index)
-    {
-        queue->is_empty = 1;
-    }
-
-    if (rt_data_queue_len(queue) <= queue->lwm)
-    {
-        /* there is at least one thread in suspended list */
-        if (!rt_list_isempty(&(queue->suspended_push_list)))
-        {
