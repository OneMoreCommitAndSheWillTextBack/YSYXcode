-
-struct dfs_file *fdt_fd_get(struct dfs_fdtable* fdt, int fd)
-{
-    struct dfs_file *d;
-
-    if (fd < 0 || fd >= (int)fdt->maxfd)
-    {
-        return NULL;
-    }
-
-    dfs_file_lock();
-    d = fdt->fds[fd];
-
-    /* check dfs_file valid or not */
-    if ((d == NULL) || (d->magic != DFS_FD_MAGIC))
-    {
-        dfs_file_unlock();
-        return NULL;
-    }
-
-    dfs_file_unlock();
-
-    return d;
-}
