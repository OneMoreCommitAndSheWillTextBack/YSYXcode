-static size_t load_fread(void *ptr, size_t size, size_t nmemb, int fd)
-{
-    size_t read_block = 0;
-
-    while (nmemb)
-    {
-        size_t count;
-
-        count = read(fd, ptr, size * nmemb) / size;
-        if (count < nmemb)
-        {
-            LOG_E("ERROR: file size error!");
-            break;
-        }
-
-        ptr = (void *)((uint8_t *)ptr + (count * size));
-        nmemb -= count;
-        read_block += count;
-    }
-
-    return read_block;
-}
