-static rt_err_t rt_usbh_adk_enable(void* arg)
-{
-    int i = 0;
-    uadk_t adk;
-    struct uintf* intf = (struct uintf*)arg;
-    udev_desc_t dev_desc;
-    rt_uint16_t protocol;
-    rt_err_t ret;
-
-    /* parameter check */
-    if(intf == RT_NULL)
-    {
-        rt_kprintf("the interface is not available\n");
