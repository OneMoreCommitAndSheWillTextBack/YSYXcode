-        return EINVAL;
-    }
-    /* which is not initialized */
-    if (cond->attr == -1)
-    {
-        return 0;
-    }
-
-    if (!rt_list_isempty(&cond->sem.parent.suspend_thread))
-    {
-        return EBUSY;
-    }
-__retry:
-    result = rt_sem_trytake(&(cond->sem));
-    if (result == EBUSY)
-    {
-        pthread_cond_broadcast(cond);
-        goto __retry;
-    }
