-
-        switch (tag) {
-        case FDT_END:
-            if (nextoffset >= 0)
-                return -FDT_ERR_BADSTRUCTURE;
-            else
-                return nextoffset;
-
-        case FDT_PROP:
-            return offset;
-        }
-        offset = nextoffset;
-    } while (tag == FDT_NOP);
