-        _sta_mgnt.state &= ~RT_WLAN_STATE_CONNECTING;
-        _sta_mgnt.state &= ~RT_WLAN_STATE_READY;
-        user_event = RT_WLAN_EVT_STA_CONNECTED_FAIL;
