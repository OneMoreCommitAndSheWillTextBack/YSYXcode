-
-    return err;
-}
-
-int rt_aspace_traversal(rt_aspace_t aspace,
-                        int (*fn)(rt_varea_t varea, void *arg), void *arg)
-{
-    rt_varea_t varea;
-    WR_LOCK(aspace);
-    varea = ASPACE_VAREA_FIRST(aspace);
-    while (varea)
-    {
-        fn(varea, arg);
-        varea = ASPACE_VAREA_NEXT(varea);
-    }
-    WR_UNLOCK(aspace);
-
-    return 0;
-}
-
-static int _dump(rt_varea_t varea, void *arg)
