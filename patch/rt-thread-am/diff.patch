-
-    if (sensor->module)
-    {
-        rt_mutex_take(sensor->module->lock, RT_WAITING_FOREVER);
-    }
-    if (sensor->ops->control != RT_NULL)
-    {
-        local_ctrl = sensor->ops->control;
-    }
-
-    switch (cmd)
-    {
-        case RT_SENSOR_CTRL_GET_ID:
-            if (args)
