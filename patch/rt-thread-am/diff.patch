-rt_size_t ulog_ultoa(char *s, unsigned long int n)
-{
-    rt_size_t i = 0, j = 0, len = 0;
-    char swap;
-
-    do
-    {
-        s[len++] = n % 10 + '0';
-    } while (n /= 10);
-    s[len] = '\0';
-    /* reverse string */
-    for (i = 0, j = len - 1; i < j; ++i, --j)
-    {
-        swap = s[i];
-        s[i] = s[j];
-        s[j] = swap;
-    }
-    return len;
-}
