-int rt_wlan_prot_ready_event(struct rt_wlan_device *wlan, struct rt_wlan_buff *buff)
-{
-    rt_base_t level;
-
-    if ((wlan == RT_NULL) || (_sta_mgnt.device != wlan) ||
