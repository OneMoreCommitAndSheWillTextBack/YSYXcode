-                            break;
-                        }
-                    }
-                    if (result == SFUD_SUCCESS) {
-                        time_cast = rt_tick_get() - start_time;
-                        rt_kprintf("Read benchmark success, total time: %d.%03dS.\n", time_cast / RT_TICK_PER_SECOND,
