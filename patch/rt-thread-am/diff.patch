-        {
-            put_tty_queue(c, ldata);
-            continue;
-        }
-
-        if (!test_bit(c, (int *)ldata->char_map))
-        {
-            n_tty_receive_char_inline(tty, c);
-        }
-        else if (n_tty_receive_char_special(tty, c) && count)
