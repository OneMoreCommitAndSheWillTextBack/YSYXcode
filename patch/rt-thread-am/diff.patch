-static speed_t _get_speed(int baudrate)
-{
-    int index;
-
-    for (index = 0; index < sizeof(_tbl)/sizeof(_tbl[0]); index ++)
-    {
-        if (_tbl[index].baudrate == baudrate)
-            return _tbl[index].speed;
-    }
-
-    return B0;
