-            else:
-                CPPPATH = CPPPATH + [os.path.join(cwd, path)]
-
-    CPPDEFINES = ExtendPackageVar(package, 'CPPDEFINES')
-
-    objs = DefineGroup(package['name'], src, depend = depend, CPPPATH = CPPPATH, CPPDEFINES = CPPDEFINES)
