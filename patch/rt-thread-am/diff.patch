-void utest_unit_run(test_unit_func func, const char *unit_func_name)
-{
-    // LOG_I("[==========] utest unit name: (%s)", unit_func_name);
-    local_utest.error = UTEST_PASSED;
-    local_utest.passed_num = 0;
