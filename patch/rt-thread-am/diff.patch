-static void rt_wlan_complete_delete(struct rt_wlan_complete_des *complete)
-{
-    if (complete == RT_NULL)
-    {
-        return;
-    }
-    COMPLETE_LOCK();
-    complete_tab[complete->index] = RT_NULL;
-    COMPLETE_UNLOCK();
-    rt_event_detach(&complete->complete);
-    rt_free(complete);
