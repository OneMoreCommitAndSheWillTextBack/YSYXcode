-static int serial_fops_ioctl(struct dfs_file *fd, int cmd, void *args)
-{
-    rt_device_t device;
-    int flags = (int)(rt_base_t)args;
-    int mask  = O_NONBLOCK | O_APPEND;
-
-    device = (rt_device_t)fd->vnode->data;
-    switch (cmd)
-    {
-    case FIONREAD:
-        break;
-    case FIONWRITE:
-        break;
-    case F_SETFL:
-        flags &= mask;
-        fd->flags &= ~mask;
-        fd->flags |= flags;
-        break;
-    }
-
-    return rt_device_control(device, cmd, args);
-}
