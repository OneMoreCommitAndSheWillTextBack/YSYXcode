-+/* IRQ operation under VMM */
-+static inline unsigned long vmm_irq_save(void)
-+{
-+	unsigned long flags;
-+
-+	asm volatile(
-+		"	mrs	%0, cpsr	@ arch_local_irq_save\n"
-+		"	cpsid	i"
-+		: "=r" (flags) : : "memory", "cc");
-+	return flags;
-+}
-+
-+static inline void vmm_irq_restore(unsigned long flags)
-+{
-+	asm volatile(
-+		"	msr	cpsr_c, %0	@ local_irq_restore"
-+		:
-+		: "r" (flags)
-+		: "memory", "cc");
-+}
-+
