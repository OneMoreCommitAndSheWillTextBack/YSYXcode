-rt_size_t ulog_strcpy(rt_size_t cur_len, char *dst, const char *src)
-{
-    const char *src_old = src;
-
-    RT_ASSERT(dst);
-    RT_ASSERT(src);
-
-    while (*src != 0)
-    {
-        /* make sure destination has enough space */
-        if (cur_len++ < ULOG_LINE_BUF_SIZE)
-        {
-            *dst++ = *src++;
-        }
-        else
-        {
-            break;
-        }
-    }
-    return src - src_old;
-}
