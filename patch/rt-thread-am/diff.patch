-static rt_err_t _function_disable(ufunction_t func)
-{
-    LOG_D("plugged out");
-
-    eth_device_linkchange(&((rt_ecm_eth_t)func->user_data)->parent, RT_FALSE);
-
-    /* reset eth rx tx */
-    ((rt_ecm_eth_t)func->user_data)->rx_size = 0;
-    ((rt_ecm_eth_t)func->user_data)->rx_offset = 0;
-
-    return RT_EOK;
-}
