-
-    to_thread = _scheduler_get_highest_priority_thread(&highest_ready_priority);
-
-    rt_current_thread = to_thread;
-
-    rt_schedule_remove_thread(to_thread);
-    to_thread->stat = RT_THREAD_RUNNING;
-
-    /* switch to new thread */
-
