-#define RT_MEMHEAP_USED         0x01
-#define RT_MEMHEAP_FREED        0x00
-
-#define RT_MEMHEAP_IS_USED(i)   ((i)->magic & RT_MEMHEAP_USED)
-#define RT_MEMHEAP_MINIALLOC    RT_ALIGN(12, RT_ALIGN_SIZE)
