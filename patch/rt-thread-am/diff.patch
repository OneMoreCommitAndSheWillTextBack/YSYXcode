-static uint8_t crc7(const uint8_t *buf, int len)
-{
-    unsigned char   i, j, crc, ch, ch2, ch3;
-
-    crc = 0;
-
-    for (i = 0; i < len; i ++)
-    {
-        ch = buf[i];
-
-        for (j = 0; j < 8; j ++, ch <<= 1)
-        {
-            ch2 = (crc & 0x40) ? 1 : 0;
-            ch3 = (ch & 0x80) ? 1 : 0;
-
-            if (ch2 ^ ch3)
-            {
-                crc ^= 0x04;
-                crc <<= 1;
-                crc |= 0x01;
-            }
-            else
-            {
-                crc <<= 1;
-            }
-        }
-    }
-
-    return crc;
-}
