-	};
-
-	active = sym_get_choice_value(menu->sym);
-	/* this is mostly duplicated from the conf() function. */
-	while (!global_exit) {
-		reset_menu();
-
-		for (i = 0, child = menu->list; child; child = child->next) {
-			if (!show_all_items && !menu_is_visible(child))
