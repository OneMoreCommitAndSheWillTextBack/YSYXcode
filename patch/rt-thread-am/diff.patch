-		err=$?
-		if [ $err -ne 0 ]; then
-			echo "[rt-thread][cppcheck] we found a obvious fault, please fix the error then commit again"
-			exit $err
-		else
-			echo "[rt-thread][cppcheck] cppcheck ok."
-		fi
-	fi
-else
-    echo "cppcheck does not exist" 
