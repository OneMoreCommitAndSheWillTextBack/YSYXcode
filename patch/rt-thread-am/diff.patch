-    }
-    case RT_WLAN_DEV_EVT_SCAN_REPORT:
-    {
-        RT_WLAN_LOG_D("event: SCAN_REPORT");
-        user_event = RT_WLAN_EVT_SCAN_REPORT;
-        break;
-    }
-    case RT_WLAN_DEV_EVT_SCAN_DONE:
-    {
-        RT_WLAN_LOG_D("event: SCAN_DONE");
