-                            flag_need_replace = True
-                            break
-
-                    if flag_need_replace == True:
-                        f.seek(0)
-                        content = f.read()
-                        f.seek(0)
-                        f.truncate()
-                        newcontent = content.replace(oldline, newline)
-                        f.write(newcontent)
-
-            elif os.path.splitext(file)[1] == '.lds': # find .lds files (GCC)
-                with open(file_path,'r+',) as f:
-                    flag_need_replace = False
-                    while True:
