-			val = 0 - val; sign = '-';
-		} else {
-			sign = '+';
-		}
-		if (isinf(val)) {		/* Infinite? */
-			er = "INF";
-		} else {
-			if (fmt == 'f') {	/* Decimal notation? */
-				val += i10x(0 - prec) / 2;	/* Round (nearest) */
-				m = ilog10(val);
-				if (m < 0) m = 0;
-				if (m + prec + 3 >= SZ_NUM_BUF) er = "OV";	/* Buffer overflow? */
-			} else {			/* E notation */
