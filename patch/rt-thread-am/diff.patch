-                    while(cnt2 < cnt3)
-                    {
-                        *p++ = _tio_buf[cnt2++];
-                    }
-
-                    /* load the window size date */
-                    p_winsize->ws_col = atoi(col_s);
-                    p_winsize->ws_row = atoi(row_s);
