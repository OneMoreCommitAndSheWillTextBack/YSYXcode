-static rt_uint16_t CRC16(unsigned char *q, int len)
-{
-    rt_uint16_t crc = 0;
-
-    while (len-- > 0)
-        crc = (crc << 8) ^ ccitt_table[((crc >> 8) ^ *q++) & 0xff];
-    return crc;
-}
-#else
-static rt_uint16_t CRC16(unsigned char *q, int len)
-{
-    rt_uint16_t crc;
-    char i;
-
-    crc = 0;
-    while (--len >= 0)
-    {
-        crc = crc ^ (int) * q++ << 8;
-        i = 8;
-        do
-        {
-            if (crc & 0x8000)
-                crc = crc << 1 ^ 0x1021;
-            else
-                crc = crc << 1;
-        }
-        while (--i);
-    }
-
-    return (crc);
-}
-#endif
