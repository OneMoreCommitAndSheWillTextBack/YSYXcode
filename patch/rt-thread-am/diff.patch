-#include <rpc/rpc.h>
-
-static struct timeval timeout = { 5, 0 };
-static struct timeval tottimeout = { 60, 0 };
-
-
-bool_t xdr_pmap(XDR *xdrs, struct pmap *regs)
-{
-    if (xdr_u_long(xdrs, &regs->pm_prog) &&
-        xdr_u_long(xdrs, &regs->pm_vers) &&
