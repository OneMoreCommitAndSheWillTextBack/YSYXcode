-    int should_pend = 0;
-
-    for (i = 0; i < ARRAY_SIZE(_vmm_context->virq_pending); i++)
-    {
-        should_pend |= _vmm_context->virq_pending[i];
-    }
-
-    res = (_vmm_context->virq_pended == !!should_pend);
-
-    if (!res)
-    {
-        vmm_info("--- %x %x, %x\n",
-                 _vmm_context->virq_pended, should_pend, !!should_pend);
