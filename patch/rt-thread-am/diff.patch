-void dfs_lock(void)
-{
-    rt_err_t result = -RT_EBUSY;
-
-    while (result == -RT_EBUSY)
-    {
-        result = rt_mutex_take(&fslock, RT_WAITING_FOREVER);
-    }
-
-    if (result != RT_EOK)
-    {
-        RT_ASSERT(0);
-    }
-}
