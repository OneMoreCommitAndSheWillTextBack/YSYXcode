-
-    device = (rt_device_t)fd->vnode->data;
-
-    do
-    {
-        size = rt_device_read(device, -1,  buf, count);
-        if (size <= 0)
-        {
-            if (fd->flags & O_NONBLOCK)
-            {
-                size = -EAGAIN;
-                break;
-            }
-
-            wait_ret = rt_wqueue_wait_interruptible(&(device->wait_queue), 0, RT_WAITING_FOREVER);
-            if (wait_ret != RT_EOK)
-            {
-                break;
-            }
-        }
-    }while (size <= 0);
-
-    if (size < 0)
-    {
-        size = 0;
-    }
-    return size;
-}
