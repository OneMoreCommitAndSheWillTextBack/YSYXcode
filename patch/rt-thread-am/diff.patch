-            _thread_keys[index].is_used = 1;
-            _thread_keys[index].destructor = destructor;
-
-            *key = index;
-
-            rt_exit_critical();
-
-            return 0;
-        }
-    }
-
-    rt_exit_critical();
-
-    return EAGAIN;
-}
