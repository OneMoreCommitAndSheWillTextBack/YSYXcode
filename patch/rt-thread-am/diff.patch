-
-#define MAX_MARSHEL_SIZE 64
-
-struct nfs_credentia
-{
-    rt_uint32_t stamp;
-    char *name;
-    rt_uint32_t uid;
-    rt_uint32_t gid;
-    rt_uint32_t *auxi;
-    rt_uint32_t auxi_count;
-};
-
-static void authnone_verf(AUTH *);
