-void main_thread_entry(void *parameter)
-{
-    extern int main(void);
-
-#ifdef RT_USING_COMPONENTS_INIT
-    /* RT-Thread components initialization */
-    rt_components_init();
-#endif /* RT_USING_COMPONENTS_INIT */
-
-#ifdef RT_USING_SMP
-    rt_hw_secondary_cpu_up();
