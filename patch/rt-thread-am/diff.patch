-		}
-
-		/* Initialize FAT area */
-		memset(buf, 0, sz_buf * ss);
-		sect = b_fat;		/* FAT start sector */
-		for (i = 0; i < n_fat; i++) {			/* Initialize FATs each */
-			if (fsty == FS_FAT32) {
