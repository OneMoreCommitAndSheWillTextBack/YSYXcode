-int dfs_mount(const char   *device_name,
-              const char   *path,
-              const char   *filesystemtype,
-              unsigned long rwflag,
-              const void   *data)
-{
-    const struct dfs_filesystem_ops **ops;
-    struct dfs_filesystem *iter;
-    struct dfs_filesystem *fs = NULL;
-    char *fullpath = NULL;
