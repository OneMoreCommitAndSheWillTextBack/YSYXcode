-    superblock = (struct tmpfs_sb *)fs->data;
-    RT_ASSERT(superblock != NULL);
-
-    _free_subdir(&(superblock->root));
-    rt_free(superblock);
-
-    fs->data = NULL;
-
-    return RT_EOK;
-}
-
-int dfs_tmpfs_statfs(struct dfs_filesystem *fs, struct statfs *buf)
-{
-    struct tmpfs_sb *superblock;
