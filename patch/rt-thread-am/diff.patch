-/* Flush remaining characters in the buffer */
-
-static int putc_flush (putbuff* pb)
-{
-	UINT nw;
-
-	if (   pb->idx >= 0	/* Flush buffered characters to the file */
-		&& f_write(pb->fp, pb->buf, (UINT)pb->idx, &nw) == FR_OK
-		&& (UINT)pb->idx == nw) return pb->nchr;
-	return -1;
-}
