-    struct rt_audio_pipe *pipe;
-
-    pipe = (struct rt_audio_pipe *)dev;
-
-    if (cmd == PIPE_CTRL_GET_SPACE && args)
-        *(rt_size_t *)args = rt_ringbuffer_space_len(&pipe->ringbuffer);
-    return RT_EOK;
-}
