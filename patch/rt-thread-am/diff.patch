-def BuildPackage(package):
-    import json
-    f = open(package)
-    package_json = f.read()
-
-    # get package.json path
-    cwd = os.path.dirname(package)
-
-    package = json.loads(package_json)
-
-    # check package name
-    if 'name' not in package:
-        return []
-
-    # get depends
-    depend = ExtendPackageVar(package, 'depends')
-
-    src = []
