-                      rt_tick_from_millisecond(AUTO_CONNECTION_PERIOD_MS),
-                      RT_TIMER_FLAG_PERIODIC | RT_TIMER_FLAG_SOFT_TIMER);
-#endif
-        _init_flag = 1;
-    }
-    return 0;
-}
-INIT_PREV_EXPORT(rt_wlan_init);
-
-#endif
