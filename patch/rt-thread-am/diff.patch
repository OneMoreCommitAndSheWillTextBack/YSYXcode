-
-    return 1 +
-        (ucs >= 0x1100 &&
-        (ucs <= 0x115f ||                    /* Hangul Jamo init. consonants */
-        (ucs >= 0x2e80 && ucs <= 0xa4cf && (ucs & ~0x0011) != 0x300a &&
