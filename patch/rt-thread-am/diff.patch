-int fdt_fd_new(struct dfs_fdtable *fdt)
-{
-    int idx;
-
-    /* lock filesystem */
-    dfs_file_lock();
-
-    /* find an empty fd entry */
-    idx = fd_alloc(fdt, DFS_STDIO_OFFSET);
-
-    /* can't find an empty fd entry */
-    if (idx < 0)
-    {
-        LOG_E("DFS fd new is failed! Could not found an empty fd entry.");
-    }
-
-    dfs_file_unlock();
-    return idx;
-}
