-            show_textbox(NULL, _("Can't create file!  Probably a nonexistent directory."), 5, 60);
-            break;
-        case 1:
-            show_helptext(_("Save Alternate Configuration"), save_config_help);
-            break;
-        case KEY_ESC:
-            return;
-        }
