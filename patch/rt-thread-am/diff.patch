-    volatile uint64_t *expected_ptr = (volatile uint64_t *)expected;
-    rt_base_t level;
-    bool exchanged;
-    level = rt_hw_interrupt_disable();
-    if (*val_ptr == *expected_ptr)
-    {
-        *val_ptr = desired;
-        exchanged = true;
-    }
-    else
-    {
-        *expected_ptr = *val_ptr;
-        exchanged = false;
-    }
-    rt_hw_interrupt_enable(level);
-    return exchanged;
-}
