-def _help_info(sc):
-    # Returns a string with the help text(s) of 'sc' (Symbol or Choice).
-    # Symbols and choices defined in multiple locations can have multiple help
-    # texts.
-
-    s = ""
-
-    for node in sc.nodes:
-        if node.help is not None:
-            s += node.help + "\n\n"
-
-    return s
