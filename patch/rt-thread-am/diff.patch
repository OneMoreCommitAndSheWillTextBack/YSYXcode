-static void user_ap_info_callback(int event, struct rt_wlan_buff *buff, void *parameter)
-{
-    struct rt_wlan_info *info = RT_NULL;
-    int index = 0;
-    int ret = RT_EOK;
-
-    RT_ASSERT(event == RT_WLAN_EVT_SCAN_REPORT);
