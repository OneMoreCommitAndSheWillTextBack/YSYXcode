-/*
- * CRC16_CCITT
- */
-static rt_uint16_t rt_wlan_cal_crc(rt_uint8_t *buff, int len)
-{
-    rt_uint16_t wCRCin = 0x0000;
-    rt_uint16_t wCPoly = 0x1021;
-    rt_uint8_t  wChar = 0;
-
-    while (len--)
-    {
-        int i;
-
-        wChar = *(buff++);
-        wCRCin ^= (wChar << 8);
-
-        for (i = 0; i < 8; i++)
-        {
-            if (wCRCin & 0x8000)
-                wCRCin = (wCRCin << 1) ^ wCPoly;
-            else
-                wCRCin = wCRCin << 1;
-        }
-    }
-    return wCRCin;
-}
