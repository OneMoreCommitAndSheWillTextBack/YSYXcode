-    }
-    else
-    {
-        err = _do_named_map(
-            varea->aspace,
-            vaddr,
-            length,
-            MM_PA_TO_OFF(paddr),
-            varea->attr
-        );
-    }
-    return err;
-}
-
-int rt_aspace_offload_page(rt_aspace_t aspace, void *addr, rt_size_t npage)
