-static rt_err_t _sensor_control(rt_device_t dev, int cmd, void *args)
-{
-    rt_sensor_t sensor = (rt_sensor_t)dev;
-    rt_err_t result = RT_EOK;
-    RT_ASSERT(dev != RT_NULL);
