-static int __send_status(struct rt_mmcsd_card *card, rt_uint32_t *status, unsigned retries)
-{
-    int err;
-    struct rt_mmcsd_cmd cmd;
-
-    cmd.busy_timeout = 0;
-    cmd.cmd_code = SEND_STATUS;
-    cmd.arg = card->rca << 16;
-    cmd.flags = RESP_R1 | CMD_AC;
-    err = mmcsd_send_cmd(card->host, &cmd, retries);
-    if (err)
-        return err;
-
