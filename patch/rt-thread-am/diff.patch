-    {B2400, BAUD_RATE_2400},
-    {B4800, BAUD_RATE_4800},
-    {B9600, BAUD_RATE_9600},
-    {B19200, BAUD_RATE_19200},
-    {B38400, BAUD_RATE_38400},
-    {B57600, BAUD_RATE_57600},
-    {B115200, BAUD_RATE_115200},
