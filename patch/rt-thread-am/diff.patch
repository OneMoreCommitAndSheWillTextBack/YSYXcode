-			if (fr != FR_OK) LEAVE_MKFS(fr);
-		}
-	}
-
-	if (disk_ioctl(pdrv, CTRL_SYNC, 0) != RES_OK) LEAVE_MKFS(FR_DISK_ERR);
-
-	LEAVE_MKFS(FR_OK);
-}
