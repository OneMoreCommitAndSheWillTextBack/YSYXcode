-def _value_info(sym):
-    # Returns a string showing 'sym's value
-
-    # Only put quotes around the value for string symbols
-    return "Value: {}\n".format(
-        '"{}"'.format(sym.str_value)
-        if sym.orig_type == STRING
-        else sym.str_value)
