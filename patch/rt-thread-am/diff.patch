-    }
-    else if (file->vnode->type == FT_REGULAR)
-    {
-        struct nfs_file *fd;
-
-        fd = (struct nfs_file *)nfs->data;
-
-        xdr_free((xdrproc_t)xdr_nfs_fh3, (char *)&fd->handle);
