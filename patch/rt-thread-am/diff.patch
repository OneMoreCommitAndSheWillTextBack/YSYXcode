-        rt_list_remove(&(thread->tlist));
-    }
-    rt_hw_interrupt_enable(level);
-#else
-    if (l->next != l)
-    {
-        thread = rt_list_entry(l->next,
-                struct rt_thread,
-                tlist);
-        level = rt_hw_interrupt_disable();
-        rt_list_remove(&(thread->tlist));
-        rt_hw_interrupt_enable(level);
-    }
-#endif
-    return thread;
-}
