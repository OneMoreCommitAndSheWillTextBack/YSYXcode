-    RT_ASSERT(setup != RT_NULL);
-
-    /* set address in device control driver */
-    dcd_set_address(device->dcd, setup->wValue);
-
-    /* issue status stage */
-    dcd_ep0_send_status(device->dcd);
-
-    RT_DEBUG_LOG(RT_DEBUG_USB, ("_set_address\n"));
