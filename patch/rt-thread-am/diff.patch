-    case RH_SET_PORT_STATUS:
-        hcd->roothub->port_status[port-1] = (*(rt_uint32_t *)args);
-        break;
-    case RH_CLEAR_PORT_FEATURE:
-        switch(((rt_uint32_t)args))
-        {
