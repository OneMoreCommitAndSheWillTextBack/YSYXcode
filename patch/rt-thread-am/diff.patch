-/* convert to ascii */
-static void zsend_ascii(rt_uint8_t c)
-{
-    const char hex[] = "0123456789abcdef";
-
-    zsend_line(hex[(c&0xF0)>>4]);
-    zsend_line(hex[(c)&0xF]);
-
-    return;
-}
