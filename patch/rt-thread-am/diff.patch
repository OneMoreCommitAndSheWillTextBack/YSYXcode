-     * safe to set the bits without locks. */
-    _vmm_context->virq_pending[irq / 32] |= (1 << (irq % 32));
-    _vmm_context->virq_pended = 1;
-    /* mask this IRQ in host */
-    rt_hw_interrupt_mask(irq);
-}
