-        /* get a class creater */
-        udclass = rt_list_entry(i, struct udclass, list);
-        /* create a function object */
-        func = udclass->rt_usbd_function_create(udevice);
-        /* add the function to the configuration */
-        rt_usbd_config_add_function(cfg, func);
