-#if FF_USE_LFN
-/*-----------------------------------------------------------------------*/
-/* FAT-LFN: Calculate checksum of an SFN entry                           */
-/*-----------------------------------------------------------------------*/
-
-static BYTE sum_sfn (
-	const BYTE* dir		/* Pointer to the SFN entry */
-)
-{
-	BYTE sum = 0;
-	UINT n = 11;
-
-	do {
-		sum = (sum >> 1) + (sum << 7) + *dir++;
-	} while (--n);
-	return sum;
-}
-
-#endif	/* FF_USE_LFN */
