-static DWORD make_rand (
-	DWORD seed,		/* Seed value */
-	BYTE* buff,		/* Output buffer */
-	UINT n			/* Data length */
-)
-{
-	UINT r;
-
-
-	if (seed == 0) seed = 1;
-	do {
-		for (r = 0; r < 8; r++) seed = seed & 1 ? seed >> 1 ^ 0xA3000000 : seed >> 1;	/* Shift 8 bits the 32-bit LFSR */
-		*buff++ = (BYTE)seed;
-	} while (--n);
-	return seed;
