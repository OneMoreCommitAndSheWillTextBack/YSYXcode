-                                          sizeof(struct ramfs_dirent));
-                if (dirent == NULL)
-                {
-                    return -ENOMEM;
-                }
-
-                /* remove '/' separator */
-                name_ptr = file->vnode->path;
-                while (*name_ptr == '/' && *name_ptr)
-                {
-                    name_ptr++;
-                }
