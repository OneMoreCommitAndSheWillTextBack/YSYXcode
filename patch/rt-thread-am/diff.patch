-static double i10x (int n)	/* Calculate 10^n in integer input */
-{
-	double rv = 1;
-
-	while (n > 0) {		/* Left shift */
-		if (n >= 5) {
-			rv *= 100000; n -= 5;
-		} else {
-			rv *= 10; n--;
-		}
-	}
-	while (n < 0) {		/* Right shift */
-		if (n <= -5) {
-			rv /= 100000; n += 5;
-		} else {
-			rv /= 10; n++;
-		}
-	}
-	return rv;
-}
