-struct interval
-{
-    long first;
-    long last;
-};
-
-static int bisearch(wchar_t ucs, const struct interval *table, int max)
-{
-    int min = 0;
-    int mid;
-
-    if (ucs < table[0].first || ucs > table[max].last)
-    {
-        return 0;
-    }
-
-    while (max >= min)
-    {
-        mid = (min + max) / 2;
-        if (ucs > table[mid].last)
-        {
-            min = mid + 1;
-        }
-        else if (ucs < table[mid].first)
-        {
-            max = mid - 1;
-        }
-        else
-        {
-            return 1;
-        }
-    }
-
-    return 0;
-}
-
