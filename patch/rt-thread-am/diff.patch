-rt_err_t sys_dup(int oldfd)
-{
-    int newfd = -1;
-    struct dfs_fdtable *fdt = NULL;
-
-    dfs_file_lock();
-    /* check old fd */
-    fdt = dfs_fdtable_get();
-    if ((oldfd < 0) || (oldfd >= fdt->maxfd))
-    {
-        goto exit;
-    }
-    if (!fdt->fds[oldfd])
-    {
-        goto exit;
-    }
-    /* get a new fd */
-    newfd = fd_slot_alloc(fdt, DFS_STDIO_OFFSET);
-    if (newfd >= 0)
-    {
-        fdt->fds[newfd] = fdt->fds[oldfd];
-        /* inc ref_count */
-        fdt->fds[newfd]->ref_count++;
-    }
-exit:
-    dfs_file_unlock();
-    return newfd;
-}
