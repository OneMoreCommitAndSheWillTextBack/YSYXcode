-    rt_tick_t current_tick;
-    struct rt_timer *t;
-    rt_base_t level;
-    rt_list_t list;
-
-    rt_list_init(&list);
-
-    RT_DEBUG_LOG(RT_DEBUG_TIMER, ("software timer check enter\n"));
-
-    /* disable interrupt */
-    level = rt_hw_interrupt_disable();
