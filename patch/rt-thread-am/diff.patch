-        {
-            /* enable cycle counter */
-            DWT->CTRL |= (1UL << DWT_CTRL_CYCCNTENA_Pos);
-        }
-
-        clock_cpu_setops(&_cortexm_ops);
-    }
-#endif /* PKG_USING_PERF_COUNTER */
-    return 0;
-}
-INIT_BOARD_EXPORT(cortexm_cputime_init);
