-                    rt_kprintf("close client connection, errno: %d\n", rt_get_errno());
-                    /* connection closed. */
-                    lwip_close(connected);
-                    break;
-                }
-
-                /* send data to client */
-                send(connected, recv_data, bytes_received, 0);
-            }
-        }
-    }
-
-_exit:
