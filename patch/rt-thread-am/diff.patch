-    ufunction_t func;
-    rt_err_t ret;
-
-    /* parameter check */
-    RT_ASSERT(device != RT_NULL);
-    RT_ASSERT(setup != RT_NULL);
-
-    RT_DEBUG_LOG(RT_DEBUG_USB, ("_request_interface\n"));
-
-    intf = rt_usbd_find_interface(device, setup->wIndex & 0xFF, &func);
-    if (intf != RT_NULL)
-    {
