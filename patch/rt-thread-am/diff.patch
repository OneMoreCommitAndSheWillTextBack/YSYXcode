-rt_err_t rt_raw_channel_reply(rt_channel_t ch, rt_channel_msg_t data)
-{
-    rt_ipc_msg_t msg;
-    struct rt_thread *thread;
-    register rt_base_t temp;
-
-    if (ch == RT_NULL)
