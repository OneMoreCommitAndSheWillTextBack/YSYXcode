-
-    if (((p + oldlen) < p) || ((p + oldlen) > end))
-        return -FDT_ERR_BADOFFSET;
-    if ((p < (char *)fdt) || ((end - oldlen + newlen) < (char *)fdt))
-        return -FDT_ERR_BADOFFSET;
-    if ((end - oldlen + newlen) > ((char *)fdt + fdt_totalsize(fdt)))
-        return -FDT_ERR_NOSPACE;
