-    const char* sf_help_info[] = {
-            [CMD_PROBE_INDEX]     = "sf probe [spi_device]           - probe and init SPI flash by given 'spi_device'",
-            [CMD_READ_INDEX]      = "sf read addr size               - read 'size' bytes starting at 'addr'",
