-static gpt_header *alloc_read_gpt_header(struct rt_mmcsd_card *card, size_t lba)
-{
-    gpt_header *gpt;
-    void *buf;
-
-    buf = rt_malloc(512);
-    if (!buf)
-    {
-        return RT_NULL;
-    }
-
-    if (read_lba(card, lba, (uint8_t *)buf, 1) != RT_EOK)
-    {
-        rt_free(buf);
-        return RT_NULL;
-    }
-    gpt = (gpt_header *)buf;
-
-    return gpt;
