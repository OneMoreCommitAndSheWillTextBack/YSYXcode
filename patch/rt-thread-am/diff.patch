-            if (!rt_strncmp(name, process_name, RT_NAME_MAX))
-            {
-                main_thread = rt_list_entry(lwp->t_grp.prev, struct rt_thread, sibling);
-                if (!(main_thread->stat & RT_THREAD_CLOSE))
