-void rt_vbus_isr(int irqnr, void *param)
-{
-    if (RT_VBUS_OUT_RING->blocked)
-        rt_vbus_resume_out_thread();
-
-    rt_sem_release(&_bus_in_sem);
-    rt_vbus_hw_eoi(irqnr, param);
