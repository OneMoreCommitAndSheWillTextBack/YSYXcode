-    /* register file system */
-    fs->path   = fullpath;
-    fs->ops    = *ops;
-    fs->dev_id = dev_id;
-    /* For UFS, record the real filesystem name */
-    fs->data = (void *) filesystemtype;
-
-    /* release filesystem_table lock */
-    dfs_unlock();
-
-    /* open device, but do not check the status of device */
-    if (dev_id != NULL)
-    {
-        if (rt_device_open(fs->dev_id,
