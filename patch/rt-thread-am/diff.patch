-}
-
-rt_uint32_t rt_link_sf_crc32(rt_uint8_t *data, rt_size_t len)
-{
-    rt_uint32_t x, y;
-    x = 0;
-    y = 0;
-    rt_size_t i;
-
-    for (i = 0; i < len; i++)
-    {
-        y = (crc ^ data[i]) & 0xff;
-        x = crc_table[y];
