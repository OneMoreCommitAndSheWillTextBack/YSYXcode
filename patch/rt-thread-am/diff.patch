-def VersionCmp(ver1, ver2):
-    la=[]
-    if ver1:
-        la = re.split("[. ]", ver1)
-    lb = re.split("[. ]", ver2)
-
-    f = 0
-    if len(la) > len(lb):
-        f = len(la)
-    else:
-        f = len(lb)
-    for i in range(f):
-        try:
-            if int(la[i]) > int(lb[i]):
-                return 1
-            elif int(la[i]) == int(lb[i]):
-                continue
-            else:
-                return -1
-        except (IndexError, ValueError) as e:
-            if len(la) > len(lb):
-                return 1
-            else:
-                return -1
-    return 0
