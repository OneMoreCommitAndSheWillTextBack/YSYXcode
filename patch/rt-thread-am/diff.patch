-			else
-				item_make(child, ':', "*** %s ***",
-						_(menu_get_prompt(child)));
-
-			if (child->sym == active){
-				last_top_row = top_row(curses_menu);
-				selected_index = i;
-			}
-			i++;
-		}
-		show_menu(prompt ? _(prompt) : _("Choice Menu"),
-				_(radiolist_instructions),
-				selected_index,
