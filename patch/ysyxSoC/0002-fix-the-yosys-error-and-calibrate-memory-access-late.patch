diff --git a/perip/amba/apb_delayer.v b/perip/amba/apb_delayer.v
index c0d20764..a2775249 100644
--- a/perip/amba/apb_delayer.v
+++ b/perip/amba/apb_delayer.v
@@ -1,3 +1,5 @@
+// `define FAST_APB
+
 module apb_delayer(
   input         clock,
   input         reset,
@@ -24,6 +26,8 @@ module apb_delayer(
   input         out_pslverr
 );
 
+`ifdef FAST_APB 
+
   assign out_paddr   = in_paddr;
   assign out_psel    = in_psel;
   assign out_penable = in_penable;
@@ -35,4 +39,121 @@ module apb_delayer(
   assign in_prdata   = out_prdata;
   assign in_pslverr  = out_pslverr;
 
+`else 
+  // assume the npc MHZ is 550, the device work at 100 MHZ
+  // so the r is 5.5
+  // so we set r * s = 11, so the s is 2
+  localparam R_S = 32'd11;  // r * s，用于累加阶段每周期加的值
+  localparam S = 2;      // 放大系数，用于避免小数计算
+  localparam K = 32'd5;      // 示例：设备服务请求的周期数（实际是动态的） 
+  localparam LOGS = 1;
+  localparam K_R_S = K * R_S;
+
+  typedef enum logic [1:0] {
+    ST_IDLE, ST_DELAY, ST_PSEL, ST_TRAN
+  } state_t;
+
+  // ----------------------------
+  // STATE MACHINE
+  // ----------------------------
+  // IDLE -> DELAY-> ST_PSEL -> ST_TRAN
+
+  state_t state_current_q;
+  state_t state_next;
+
+  always @(posedge clock) begin
+    if(reset) begin
+      state_current_q <= ST_IDLE;
+    end else begin
+      state_current_q <= state_next;
+    end
+  end
+
+  always @(posedge clock) begin
+    state_next = ST_IDLE;
+    case(state_current_q) 
+      ST_IDLE: begin
+        if(req_valid) begin
+          state_next = ST_DELAY;
+        end else begin
+          state_next = ST_IDLE;
+        end
+      end
+
+      ST_DELAY: begin
+        if(counter_finish) begin
+          state_next = ST_PSEL;
+        end else begin
+          state_next = ST_DELAY;
+        end
+      end
+
+      ST_PSEL: begin
+        state_next = ST_TRAN;
+      end
+
+      ST_TRAN: begin
+        if(out_pready) begin
+          state_next = ST_IDLE;
+        end else begin
+          state_next = ST_TRAN;
+        end
+      end
+    endcase
+  end
+
+  wire req_valid;  // 判断当前APB总线上是否有有效请求
+  assign req_valid = in_psel && !in_penable;   // 在psel被置高的时候进入delay
+
+  // APB协议要求：SETUP阶段(psel=1,penable=0)和ACCESS阶段(psel=1,penable=1)所有控制信号和数据都应该稳定
+  // 在ST_PSEL和ST_TRAN阶段传递所有信号，其他阶段传递无效值（因为下游不会采样，psel=0）
+  wire apb_active = (state_current_q == ST_PSEL || state_current_q == ST_TRAN);
+  
+  assign out_psel = apb_active;
+  assign out_penable = (state_current_q == ST_TRAN);
+  assign out_paddr = apb_active ? in_paddr : 32'b0;
+  assign out_pprot = apb_active ? in_pprot : 3'b0;
+  assign out_pwrite = apb_active ? in_pwrite : 1'b0;
+  assign out_pstrb = apb_active ? in_pstrb : 4'b0;
+  assign out_pwdata = apb_active ? in_pwdata : 32'b0;
+
+  assign in_prdata = out_prdata;
+  assign in_pready = (state_current_q == ST_DELAY) ? 1'b0 : out_pready;
+  assign in_pslverr = out_pslverr; 
+
+  // ----------------------------
+  // DELAY COUNTER
+  // ----------------------------
+  reg [31:0] counter;
+  reg [31:0] k_scaled;
+  wire [31:0] k_r_s = k_scaled * R_S;
+  wire [31:0] counter_next = counter + R_S;
+  wire counter_finish = (counter_next > k_r_s);
+  always @(posedge clock) begin
+    if(reset) begin
+      counter <= 32'b0;
+    end else if(state_current_q == ST_DELAY) begin
+        if(counter_finish) begin
+          counter <= (counter_next >> LOGS);
+        end else begin
+          counter <= counter_next;
+        end
+      end
+  end 
+
+  always @(posedge clock) begin
+    if(reset) begin
+      k_scaled <= K;
+    end else begin
+      if(state_current_q == ST_TRAN) begin
+        k_scaled <= k_scaled + 1'b1;
+      end else if(state_current_q == ST_PSEL) begin
+        k_scaled <= 32'b0;
+      end
+    end
+
+  end
+
+`endif
+
 endmodule
